  "audit": {
    "assumptions": [
      {
        "text": "D0 at nominal flow = 0.1/cm^2 for 5nm (N5-class)",
        "source": "TSMC-reported N5 D0 0.10-0.11/cm^2 during HVM ramp (AnandTech/ljdevice report of TSMC disclosure, 2020)"
      },
      {
        "text": "30% of D0 is time-driven; k_i calibrated to reproduce D0 at nominal flow",
        "source": "modelling assumption (docs/TECHNICAL.md s3)"
      },
      {
        "text": "systematic share of D = 25%; parametric yield = 96.0%",
        "source": "modelling assumption: systematic share rises and parametric margin shrinks with scaling"
      },
      {
        "text": "X-factor 7.5 (cycle time / raw process time)",
        "source": "~100 days / ~100 mask layers for 5nm (Semiconductor Engineering, 'Battling Fab Cycle Times'); X-factor calibrated to match"
      },
      {
        "text": "technology 'logic': reference case - node D0 figures are quoted for logic test chips",
        "source": "modelling assumption"
      },
      {
        "text": "edge exclusion 3.0 mm, scribe 80.0 um",
        "source": "typical 300 mm practice"
      },
      {
        "text": "wafer starts capacity 2,500/month",
        "source": "user input"
      },
      {
        "text": "negative binomial cluster alpha = 0.5 (random) and 2.0 (systematic)",
        "source": "specification"
      },
      {
        "text": "litho: alpha=0.5, share=0.3 - overlay misalignment accumulates as a random walk over exposure passes: error ~ sqrt(N) ~ t^0.5",
        "source": "step_library.json"
      },
      {
        "text": "etch: alpha=1.0, share=0.25 - trench/profile non-uniformity and micro-loading grow roughly linearly with etch time",
        "source": "step_library.json"
      },
      {
        "text": "dep: alpha=1.0, share=0.2 - particle adders in the chamber scale with exposure time",
        "source": "step_library.json"
      },
      {
        "text": "cmp: alpha=1.0, share=0.15 - scratches, dishing and erosion scale with polish time",
        "source": "step_library.json"
      },
      {
        "text": "thermal: alpha=0.5, share=0.07 - dopant diffusion length L = sqrt(D*t): variance grows as t^0.5",
        "source": "step_library.json"
      },
      {
        "text": "implant: alpha=1.0, share=0.03 - damage/contamination per implant pass",
        "source": "step_library.json"
      },
      {
        "text": "clean: alpha=1.0, share=0.0 - removes defects; modelled as zero contribution",
        "source": "step_library.json"
      },
      {
        "text": "metrology: alpha=1.0, share=0.0 - non-destructive; zero contribution",
        "source": "step_library.json"
      }
    ],
